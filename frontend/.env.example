# Inspire Web v2 frontend
BACKEND_URL=https://api.inspirecollege.lk    # the Inspire API on AWS (same backend as the CMS, CRM and LMS)
WEB_PROXY_SECRET=                            # same value as WEB_PROXY_SECRET in the API's .env (lets the API rate-limit per visitor)
NEXT_PUBLIC_SITE_URL=http://localhost:3110   # public URL of this site (canonical tags, sitemap)
SITE_NOINDEX=0                               # 1 on the hosted preview: hides it from search engines
