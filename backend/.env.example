# Inspire Web v2 backend
ENVIRONMENT=development

# NEW database only. For your new Supabase project: Project -> Connect -> "Session pooler" URI, e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Leave empty/commented to use a local file database (data/inspire_web_v2.db).
# DATABASE_URL=
# DATABASE_PASSWORD=          (optional: password on its own line instead of inside the URL)

JWT_SECRET=                     # long random string (python -c "import secrets;print(secrets.token_urlsafe(48))")
CORS_ORIGINS=["http://localhost:3110"]
SITE_URL=http://localhost:3110
PUBLIC_BASE_URL=http://localhost:8120   # must be public HTTPS on the server so PayHere can reach /api/v1/payments/payhere/notify

DEMO_TTL_HOURS=24

PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# MEDIA_DIR=   (default: backend/data/media)
CURRENT_API_URL=https://api.inspirecollege.lk   # read-only source for scripts/import_from_current.py

# Email (Mailjet, same account as the current API). Nothing is sent until MAIL_ENABLED=true.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_ENABLED=false
MAIL_FROM_EMAIL=enrol@inspire.college
MAIL_FROM_NAME=Inspire College
# While testing: send every email to this inbox instead of the student
MAIL_TEST_TO=

# Instalment billing job interval (issue invoices 5 days before due, reminders, send emails)
BILLING_EVERY_MINUTES=15
